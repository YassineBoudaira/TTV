digraph G { rankdir=LR; bgcolor="white"; pad=0.3; nodesep=0.35; ranksep=0.5; compound=true; newrank=true;
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, margin="0.14,0.08", color="#667"];
edge [fontname="DejaVu Sans", fontsize=10, color="#556"];
graph [fontname="DejaVu Sans", fontsize=13, style="rounded", color="#99A"];
subgraph cluster_site { label="Your website"; style="rounded,filled"; fillcolor="#FAFAFF";
wp [label="WordPress\nnestpetanimals.com", fillcolor="#EBDDFB", shape=box];
}
subgraph cluster_srv { label="Server (VPS) or your PC"; style="rounded,filled"; fillcolor="#F7FAFF";
cli [label="cli.py\ncommands, plan, edits", fillcolor="#DCEBFF", shape=box];
sync [label="wpsync.py\nread posts, hash, images", fillcolor="#DCEBFF", shape=box];
st [label="state.py\nnew / edited / partial / done", fillcolor="#DCEBFF", shape=box];
hw [label="hw.py\ndetect RAM, CPU, GPU", fillcolor="#DCEBFF", shape=box];
sc [label="scriptai.py\nscript, hook, localize", fillcolor="#DCEBFF", shape=box];
art [label="art.py\nart director + research", fillcolor="#DCEBFF", shape=box];
img [label="images.py\nimage providers + quality gate", fillcolor="#DCEBFF", shape=box];
tts [label="tts.py\nvoice engines", fillcolor="#DCEBFF", shape=box];
ren [label="render.py\ncaptions, motion, FFmpeg, audio", fillcolor="#DCEBFF", shape=box];
llm [label="llm.py\ntext AI chain", fillcolor="#DCEBFF", shape=box];
data [label="articles/ media/ output/\nstate.json  config.json  .env", fillcolor="#E3F5E1", shape=folder];
}
subgraph cluster_ext { label="AI and cloud services (free tiers)"; style="rounded,filled"; fillcolor="#FFFBF2";
gem [label="Google Gemini\ntext, web search, Nano Banana", fillcolor="#FFE8CC", shape=box];
grq [label="Groq / OpenAI-compatible", fillcolor="#FFE8CC", shape=box];
cla [label="Claude (paid, optional)", fillcolor="#EEEEEE", shape=box];
cf [label="Cloudflare FLUX.1\nimages", fillcolor="#FFE8CC", shape=box];
az [label="Azure Speech\nneural voices", fillcolor="#FFE8CC", shape=box];
edg [label="Edge neural voices\n(unofficial)", fillcolor="#FFE8CC", shape=box];
wiki [label="Wikipedia", fillcolor="#FFE8CC", shape=box];
oll [label="Ollama (local AI)", fillcolor="#EEEEEE", shape=box];
pip [label="Piper (local voice)", fillcolor="#EEEEEE", shape=box];
}
me [label="You: download videos (scp)\nand publish", fillcolor="#EBDDFB", shape=box];
pub [label="YouTube / TikTok / Instagram", fillcolor="#EBDDFB", shape=box];
wp -> sync [label="REST / RSS"];
cli -> sync;
cli -> st;
cli -> hw;
sync -> data;
st -> data;
cli -> sc;
sc -> llm;
art -> llm;
cli -> art;
cli -> img;
cli -> tts;
cli -> ren;
llm -> gem;
llm -> grq;
llm -> cla;
llm -> oll;
art -> wiki;
img -> gem;
img -> cf;
tts -> az;
tts -> edg;
tts -> pip;
ren -> data [label="videos"];
data -> me;
me -> pub;
}