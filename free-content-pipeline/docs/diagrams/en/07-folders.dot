digraph G { rankdir=LR; bgcolor="white"; pad=0.3; nodesep=0.35; ranksep=0.5; compound=true; node [shape=box];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, margin="0.14,0.08", color="#667"];
edge [fontname="DejaVu Sans", fontsize=10, color="#556"];
graph [fontname="DejaVu Sans", fontsize=13, style="rounded", color="#99A"];
root [label="free-content-pipeline/", fillcolor="#DCEBFF", shape=box];
pl [label="pipeline.py  (launcher)", fillcolor="#DCEBFF", shape=box];
ttv [label="ttv/   (the program)", fillcolor="#DCEBFF", shape=box];
sc [label="scripts/   (install, upgrade, cron)", fillcolor="#EEEEEE", shape=box];
ts [label="tests/   (unit tests + mock services)", fillcolor="#EEEEEE", shape=box];
dc [label="docs/   (guides + diagrams)", fillcolor="#EEEEEE", shape=box];
cf [label="config.json   .env   requirements.txt", fillcolor="#E3F5E1", shape=box];
ar [label="articles/   posts as .md + .json", fillcolor="#E3F5E1", shape=box];
me [label="media/<slug>/   photos of each post", fillcolor="#E3F5E1", shape=box];
mu [label="music/   optional mp3", fillcolor="#E3F5E1", shape=box];
vo [label="voices/   Piper voices", fillcolor="#E3F5E1", shape=box];
stt [label="state.json   what is done", fillcolor="#E3F5E1", shape=box];
out [label="output/", fillcolor="#CFF2D5", shape=box];
o1 [label="output/<slug>/", fillcolor="#CFF2D5", shape=box];
o2 [label="master_en.json   assets/ (prompts.json)   article.md   CHANGELOG.md", fillcolor="#CFF2D5", shape=box];
o3 [label="en/ fr/ ar/ es/  video_16x9.mp4  short_9x16.mp4  minis/  thumbnail.jpg  subtitles.srt  publish.txt", fillcolor="#CFF2D5", shape=box];
o4 [label="_archive/<slug>/rev1_DATE/   old versions of edited posts", fillcolor="#FFD9D9", shape=box];
o5 [label="_reports/   run reports + edits.md", fillcolor="#FFD9D9", shape=box];
o6 [label="_cache/research/   research cache", fillcolor="#EEEEEE", shape=box];
root -> pl;
root -> ttv;
