digraph G { rankdir=TB; bgcolor="white"; pad=0.3; nodesep=0.35; ranksep=0.5; compound=true; 
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, margin="0.14,0.08", color="#667"];
edge [fontname="DejaVu Sans", fontsize=10, color="#556"];
graph [fontname="DejaVu Sans", fontsize=13, style="rounded", color="#99A"];
wav [label="narration of one scene\n(voice engine)", fillcolor="#FFE8CC", shape=box];
pad [label="scene_audio\nlead 0.06s, 15-40 ms fades,\npause 0.45s (sentence) / 0.28s (comma)\nlength = exact number of frames", fillcolor="#DCEBFF", shape=box];
img [label="scene image", fillcolor="#FFE8CC", shape=box];
bg [label="background crop\n9:16 and 16:9", fillcolor="#DCEBFF", shape=box];
cap [label="caption layers\n3 words (vertical) / 6 words (wide)\ntimed by word timings or text length", fillcolor="#DCEBFF", shape=box];
clip [label="silent clip\nslow zoom / pan, EXACT frames", fillcolor="#DCEBFF", shape=box];
vcat [label="cut clips together\n(lossless copy)", fillcolor="#DCEBFF", shape=box];
acat [label="join sounds into ONE track\n(lossless PCM)", fillcolor="#DCEBFF", shape=box];
mus [label="music (optional)\nmixed low", fillcolor="#EEEEEE", shape=box];
norm [label="loudness -16 LUFS\nAAC encoded ONCE", fillcolor="#DCEBFF", shape=box];
mux [label="join video + audio\n-> mp4", fillcolor="#CFF2D5", shape=box];
out [label="video_16x9.mp4\nshort_9x16.mp4 (hook first, call to action last)\nminis/mini_XX.mp4\nsubtitles.srt  thumbnail.jpg", fillcolor="#CFF2D5", shape=box];
old [label="OLD way (the choppy sound):\nAAC per scene + cut by -shortest\n-> 0.06 s between sentences", fillcolor="#FFD9D9", shape=box];
wav -> pad;
img -> bg;
bg -> clip;
cap -> clip;
clip -> vcat;
pad -> acat;
mus -> acat;
acat -> norm;
vcat -> mux;
norm -> mux;
mux -> out;
pad -> cap [style=dashed, label="timing"];
old -> wav [style=invis];
}