digraph G { rankdir=TB; bgcolor="white"; pad=0.3; nodesep=0.35; ranksep=0.5; compound=true; 
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, margin="0.14,0.08", color="#667"];
edge [fontname="DejaVu Sans", fontsize=10, color="#556"];
graph [fontname="DejaVu Sans", fontsize=13, style="rounded", color="#99A"];
wav [label="تعليق مشهد واحد\n(محرك الصوت)", fillcolor="#FFE8CC", shape=box];
pad [label="scene_audio\nمقدمة 0.06ث وتلاشٍ قصير\nوقفة 0.45ث (جملة) / 0.28ث (فاصلة)\nالطول = عدد صحيح من الإطارات", fillcolor="#DCEBFF", shape=box];
img [label="صورة المشهد", fillcolor="#FFE8CC", shape=box];
bg [label="قص الخلفية\n9:16 و 16:9", fillcolor="#DCEBFF", shape=box];
cap [label="طبقات الترجمة\n3 كلمات (عمودي) / 6 (أفقي)\nبتوقيت الكلمات أو طول النص", fillcolor="#DCEBFF", shape=box];
clip [label="مقطع صامت\nتكبير/تمرير بطيء بعدد إطارات مضبوط", fillcolor="#DCEBFF", shape=box];
vcat [label="ربط المقاطع\n(نسخ بلا فقد)", fillcolor="#DCEBFF", shape=box];
acat [label="دمج الأصوات في مسار واحد\n(PCM بلا فقد)", fillcolor="#DCEBFF", shape=box];
mus [label="موسيقى (اختياري)\nبصوت منخفض", fillcolor="#EEEEEE", shape=box];
norm [label="ضبط الشدة -16 LUFS\nترميز AAC مرة واحدة", fillcolor="#DCEBFF", shape=box];
mux [label="ضم الفيديو والصوت\n-> mp4", fillcolor="#CFF2D5", shape=box];
out [label="video_16x9.mp4\nshort_9x16.mp4 (الخطاف أولاً ونداء القراءة أخيراً)\nminis/mini_XX.mp4\nsubtitles.srt  thumbnail.jpg", fillcolor="#CFF2D5", shape=box];
old [label="الطريقة القديمة (سبب التقطّع):\nAAC لكل مشهد وقص بـ -shortest\n-> 0.06 ثانية فقط بين الجمل", fillcolor="#FFD9D9", shape=box];
wav -> pad;
img -> bg;
bg -> clip;
cap -> clip;
clip -> vcat;
pad -> acat;
mus -> acat;
acat -> norm;
vcat -> mux;
norm -> mux;
mux -> out;
pad -> cap [style=dashed, label="timing"];
old -> wav [style=invis];
}